# CyberSecTool ortam degiskenleri (ORNEK)
# Gercek .env dosyasi git'e GIRMEZ; bu dosyayi .env olarak kopyalayip doldurun.

# --- Uygulama ---
APP_ENV=development
SECRET_KEY=change-me-please

# --- Veritabani (PR-02) ---
DATABASE_URL=postgresql+asyncpg://cyber:cyber@localhost:5432/cybersectool

# --- Redis / Celery (PR-06) ---
REDIS_URL=redis://localhost:6379/0

# --- Ag / dagitim (VI-7) ---
# Docker kopru ag subnet'i. Musteri ic agiyla CAKISMAMASI icin alisilmadik bir
# aralik secin (varsayilan 172.28.0.0/16). Ornek: 10.89.0.0/16
DOCKER_SUBNET=172.28.0.0/16
# Taramadan/envanterden DISLANACAK ek IP'ler (virgulle). Aracin kendi container
# IP'leri (db/redis/app...) zaten otomatik dislanir; buraya ekstra IP eklenebilir.
EXCLUDE_SCAN_IPS=

# --- Zafiyet veri kaynaklari (PR-10+) ---
# NVD API anahtari (opsiyonel ama rate-limit icin onerilir)
NVD_API_KEY=

# --- Bildirimler (PR-24) ---
# Kritik bulgu webhook'u (Slack vb.); bos birakilirsa bildirim kapali
NOTIFY_WEBHOOK_URL=

# --- GUVENLIK: Agresif (mudahaleci) tarama kilidi ---
# Agresif mod nmap NSE vuln/exploit scriptleri calistirir; hedefe MUDAHALE eder
# (servis kesintisi / iz birakma riski). Varsayilan KAPALI. Yalnizca yetkili ve
# yedegi alinmis sistemlerde, bilinerek acin. Acmak icin: true
ALLOW_AGGRESSIVE_SCANS=false

# --- Kimlik kasasi sifreleme anahtari (Fernet) ---
# Kimlik kasasindaki parolalar bu anahtarla sifreli saklanir. Bos birakilirsa
# SECRET_KEY'den turetilir (yalnizca dev). URETIMDE ayri gizli anahtar verin.
# Uretmek icin: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
