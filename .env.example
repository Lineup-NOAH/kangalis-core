# Kangalis ortam degiskenleri (ORNEK)
# Gercek .env dosyasi git'e GIRMEZ.
#
# KURULUM SIHIRBAZI (setup.sh / setup.ps1) asagidaki kimlik/secret anahtarlarini SIZIN
# icin yazar (DB/Redis parolalari + guclu SECRET_KEY + Fernet kasa anahtari). Bu yuzden
# onlar burada YORUM (kapali) durur — sihirbazi calistiracaksaniz bu dosyayi KOPYALAMAYIN,
# sihirbaz .env'i kendisi olusturur. Yalnizca ELLE (sihirbazsiz) kurulumda bu dosyayi
# '.env' olarak kopyalayip ilgili satirlari acin. Acik (yorumsuz) satirlar guvenli varsayilandir.

# --- Uygulama ---
APP_ENV=development
# Oturum imzalama + kasa anahtari turetimi. Sihirbaz GUCLU rastgele uretir. Compose
# varsayilani: dev-secret. Elle/uretim: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=change-me-please

# --- PostgreSQL (Docker: compose bu parcalardan DATABASE_URL'i @db ile kurar) ---
# Sihirbaz yazar. Varsayilan: cyber / cyber / cybersectool. NOT: parola pgdata'ya ILK
# acilista gomulur -> sonradan degistirmek icin 'docker compose down -v' (pgdata sifirla).
# POSTGRES_USER=cyber
# POSTGRES_PASSWORD=cyber
# POSTGRES_DB=cybersectool
# Docker DISI (uv run) calistiranlar icin tam URL (Docker'da compose @db ile kurar -> bu satir
# yok sayilir). POSTGRES_* degistirdiyseniz buradaki kullanici/parola/db'yi de eslestirin:
# DATABASE_URL=postgresql+asyncpg://cyber:cyber@localhost:5432/cybersectool

# --- Redis / Celery ---
# Redis parolasi (bos = auth kapali). Verilirse compose 'redis-server --requirepass' alir ve
# sihirbaz REDIS_URL'i 'redis://:PAROLA@redis:6379/0' olarak yazar.
# REDIS_PASSWORD=
# Docker DISI calistiranlar icin (Docker'da @redis varsayilani kullanilir):
# REDIS_URL=redis://localhost:6379/0

# --- Ag / dagitim (VI-7) ---
# Docker kopru ag subnet'i. Musteri ic agiyla CAKISMAMASI icin alisilmadik bir
# aralik secin (varsayilan 172.28.0.0/16). Ornek: 10.89.0.0/16
DOCKER_SUBNET=172.28.0.0/16
# Taramadan/envanterden DISLANACAK ek IP'ler (virgulle). Aracin kendi container
# IP'leri (db/redis/app...) zaten otomatik dislanir; buraya ekstra IP eklenebilir.
EXCLUDE_SCAN_IPS=

# --- Zafiyet veri kaynaklari (PR-10+) ---
# NVD API anahtari (opsiyonel ama rate-limit icin onerilir). Sihirbaz opsiyonel sorar.
# NVD_API_KEY=

# --- Bildirimler (PR-24) ---
# Kritik bulgu webhook'u (Slack vb.); bos = bildirim kapali. Sihirbaz opsiyonel sorar.
# NOTIFY_WEBHOOK_URL=

# --- GUVENLIK: Agresif (mudahaleci) tarama kilidi ---
# Agresif mod nmap NSE vuln/exploit scriptleri calistirir; hedefe MUDAHALE eder
# (servis kesintisi / iz birakma riski). Varsayilan KAPALI. Yalnizca yetkili ve
# yedegi alinmis sistemlerde, bilinerek acin. Acmak icin: true
ALLOW_AGGRESSIVE_SCANS=false

# --- Kimlik kasasi sifreleme anahtari (Fernet) ---
# Kasadaki parolalar bununla sifreli saklanir. Bos birakilirsa SECRET_KEY'den turetilir
# (yalnizca dev). Sihirbaz GUCLU bir Fernet anahtari uretir. Elle:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=

# --- Yerel AI (opsiyonel, on-prem, sifir egress) ---
# AI varsayilan KAPALI (ai_enabled DB'de, Ayarlar > AI kartindan acilir). Asagidakiler yalnizca
# VARSAYILANDIR; calisma aninda AppSettings (admin UI) override eder. Bos endpoint = AI devre disi.
# OpenAI-uyumlu yerel motor ucu (Ollama). Host'taki motor icin: http://host.docker.internal:<port>/v1
AI_ENDPOINT=http://ollama:11434/v1
AI_MODEL=qwen3:8b
# AI istek zaman asimi (sn). CPU cikarimi yavas; comert tutuldu.
AI_TIMEOUT=300
# AI hiz siniri (DoS korumasi): /ai/* uretim uclari kullanici basina pencerede sinirlanir
# (onbellek isabetleri sayilmaz). Varsayilan ACIK + comert (60/dk) -> tek-kullanici etkilenmez,
# betikli kotuye-kullanim ucuz reddedilir. Cok-kullanicili sertlestirmede dusur; tumden kapat: false.
# AI_RATELIMIT_ENABLED=true
# AI_RATELIMIT_MAX=60
# AI_RATELIMIT_WINDOW_SEC=60
# AI konteyneri RAM tavani (Ollama). Dusuk-RAM makinede kucultun (ornek: 6g).
AI_MEM_LIMIT=8g
# Air-gap / on-paketli AI imaji (docker-compose.ai-baked.yml referans alir). Bos = varsayilan
# ghcr.io/lineup-noah/kangalis-ai:qwen3-8b kullanilir.
AI_BAKED_IMAGE=

# --- Dagitim B (yayinlanmis cekirdek imaji) ---
# 'docker compose pull' ile cekilecek cekirdek imaji (app/worker/beat/mcp/migrate ayni imaj).
# Bos/yorum birakilirsa :latest kullanilir. Surum sabitlemek icin etiketi acin, ornek:
# KANGALIS_IMAGE=ghcr.io/lineup-noah/kangalis-core:v1.0.0
# KANGALIS_IMAGE=ghcr.io/lineup-noah/kangalis-core:latest
