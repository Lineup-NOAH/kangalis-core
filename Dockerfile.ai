# Kangalis AI — ÖN-PAKETLİ (model GÖMÜLÜ) yerel Ollama imajı.
#
# NE: Ollama çıkarım sunucusu + Qwen3-8B modeli TEK imaja gömülü.
# NEDEN: Kullanıcılar modeli internetten çekmesin diye — bu imaj İNDİRİLDİĞİNDE model HAZIR gelir
#   → anında çalışır + çalışma anında SIFIR dış indirme (air-gap uyumlu; LLM verisi yerel kalır).
#   Varsayılan `ollama` servisi modeli ilk açılışta `ollama pull` ile çeker; bu imaj o indirmeyi
#   BUILD anına (bizim tarafımıza) taşır.
#
# DERLEME (model ~5 GB build sırasında indirilip imaja gömülür; biten imaj internetsiz çalışır):
#   docker build -f Dockerfile.ai -t ghcr.io/lineup-noah/kangalis-ai:qwen3-8b .
#   # veya: bash build-ai-image.sh  /  powershell -File build-ai-image.ps1
#   # veya: GitHub Actions → "AI imajı (ön-paketli model)" (workflow_dispatch) bunu ghcr'a basar.
#
# KULLANIM (derlendikten/çekildikten sonra — model gömülü, indirme yok):
#   docker compose -f docker-compose.yml -f docker-compose.ai-baked.yml --profile ai up -d ollama
#
# LİSANS: Ollama = MIT, Qwen3 ağırlıkları = Apache-2.0 → her ikisi de yeniden DAĞITILABİLİR
#   (gömülebilir). Metinler imaja /licenses/ altına gömülür (bkz. licenses/, THIRD-PARTY-NOTICES.md).

# Taban: resmi Ollama sunucusu (OpenAI-uyumlu /v1, port 11434). Digest'e sabitlendi (tedarik-zinciri
# sertleştirme: mutable ":latest" sessizce değişebilir). Bu digest = Ollama 0.30.8. Güncellemek için:
#   docker pull ollama/ollama:latest && docker inspect ollama/ollama:latest --format '{{index .RepoDigests 0}}'
FROM ollama/ollama@sha256:05b6fe5143ed006d6d4abd39bdd575f962a5822bdf81e6fbb5e6894eb984ab9c

# Gömülecek model (Ollama etiketi). Varsayılan Qwen3-8B (~5 GB; CPU'da ~6 GB RAM). Başka model için
# `--build-arg AI_MODEL=...` ile override edin (compose'daki ai_model ile aynı olmalı).
ARG AI_MODEL=qwen3:8b

# Modeli BUILD'de indir + imaja GÖM: `ollama pull` için sunucuyu GEÇİCİ ayağa kaldır, model
# /root/.ollama'ya yazılır (katmana gömülür). Sınırlı bekleme (sunucu gelmezse build takılmasın).
RUN set -eux; \
    ollama serve & srv=$!; \
    for _ in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 1; done; \
    ollama list >/dev/null 2>&1 || { echo "HATA: ollama serve 60sn icinde hazir olmadi" >&2; kill "${srv}" 2>/dev/null || true; exit 1; }; \
    ollama pull "${AI_MODEL}"; \
    ollama list; \
    kill "${srv}" 2>/dev/null || true

# Model sürekli yüklü kalsın (CPU'da soğuk-yükleme cezası ~70sn olmasın).
ENV OLLAMA_KEEP_ALIVE=-1

# LİSANS BÜTÜNLÜĞÜ (yeniden-dağıtım yükümlülüğü): bu imaj Ollama ikilisini (MIT) + Qwen3 ağırlıklarını
# (Apache-2.0) YENİDEN DAĞITIR; her ikisi de lisans metninin korunmasını zorunlu kılar. Metinler
# repodan gömülür (air-gap/yeniden-üretilebilir; ayrıntı: licenses/README.md, THIRD-PARTY-NOTICES.md).
COPY licenses/ /licenses/

# ENTRYPOINT/CMD taban imajdan miras = `ollama serve` (port 11434). compose `command` ile değişmez.
